// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Site web surveillé
model Website {
  id        String     @id @default(cuid())
  url       String     @unique
  name      String
  category  String     @default("Général")
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tests     SpeedTest[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Test de performance (style Lighthouse)
model SpeedTest {
  id           String   @id @default(cuid())
  websiteId    String
  website      Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  // Score global Lighthouse (0-100)
  performance  Int
  accessibility Int
  bestPractices Int
  seo          Int
  // Core Web Vitals (INP remplace FID depuis mars 2024 — Google)
  lcp          Float  // Largest Contentful Paint (s)
  inp          Float? // Interaction to Next Paint (ms) — bon ≤ 200, moyen ≤ 500
  fid          Float  // DEPRECATED : First Input Delay, miroir de inp pour compat
  cls          Float  // Cumulative Layout Shift
  fcp          Float  // First Contentful Paint (s)
  ttfb         Float  // Time to First Byte (ms)
  tbt          Float  // Total Blocking Time (ms)
  si           Float  // Speed Index
  // Métadonnées
  device       String  @default("desktop") // desktop | mobile
  region       String  @default("europe")  // europe | na | apac
  // Origine de la mesure : lighthouse | pagespeed (mesures réelles) | simulated (démo)
  source       String  @default("simulated")
  // Résumé IA (cache pour économiser les quotas gratuits)
  aiSummary    String?
  aiModel      String?
  // Résumé traduit par langue (M1-3) : {"en": "...", "es": "..."}
  aiSummaryTranslations Json?
  // Poids des ressources (KB)
  totalWeight  Float
  // Date
  createdAt    DateTime @default(now())

  @@index([websiteId, createdAt])
  @@index([createdAt])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  tenantId     String
  tenant       Tenant    @relation("TenantMembers", fields: [tenantId], references: [id], onDelete: Cascade)
  ownedTenants Tenant[]  @relation("TenantOwner")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Tenant {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  ownerId      String?
  owner        User?          @relation("TenantOwner", fields: [ownerId], references: [id])
  members      User[]         @relation("TenantMembers")
  websites     Website[]
  subscription Subscription?
  payments     Payment[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// M0-4 — Rate-limit par utilisateur (sans Redis).
// Sliding window par (userId, action) avec expiration automatique.
// `userId` peut être "anonymous:<ip>" si l'utilisateur n'est pas authentifié.
model RateLimit {
  id          String   @id @default(cuid())
  userId      String
  action      String   // aiSummary | aiVision | aiAsr | aiImageGen | aiUrlAudit | ...
  windowStart DateTime // début de la fenêtre glissante
  count       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, action])
  @@index([userId, action, windowStart])
  @@index([windowStart]) // pour le nettoyage périodique
}

// M0-5 — Observabilité des appels IA (un par appel provider).
// Sert au dashboard admin des quotas (M7-1) et à la détection d'alerte.
model AICall {
  id         String   @id @default(cuid())
  provider   String   // groq | gemini | openrouter | zai
  model      String
  capability String   // chat | vision | embed | asr | tts | image
  success    Boolean
  latencyMs  Int
  errorCode  String?  // HTTP status ou message tronqué si échec
  userId     String?  // optionnel (peut être anonyme)
  createdAt  DateTime @default(now())

  @@index([provider, createdAt])
  @@index([capability, createdAt])
  @@index([createdAt])
}

// M0-5 — Compteur agrégé quotidien par provider (quota tracking).
// `day` est normalisé à minuit UTC pour garantir l'agrégation propre.
model AIDailyUsage {
  id       String   @id @default(cuid())
  provider String
  day      DateTime // minuit UTC du jour
  count    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, day])
  @@index([day])
}

// M-BILLING — Plan tarifaire (source de vérité, éditable en 1 clic via l'admin).
// Les prix sont en XOF (FCFA), entiers sans décimales — devise imposée par FedaPay.
model Plan {
  id            String   @id @default(cuid())
  slug          String   @unique // decouverte | starter | pro | entreprise
  name          String
  description   String
  // Prix mensuel en FCFA (entier)
  priceXof      Int
  // Prix mensuel équivalent facturé annuellement (-20%). null = pas d'offre annuelle.
  priceAnnualXof Int?
  currency      String   @default("XOF")
  // Features affichées sur la pricing page, dans l'ordre
  features      Json     // string[]
  // Limites techniques (pas encore appliquées côté API, prêtes pour le gating)
  maxSites      Int? // null = illimité
  testsPerMonth Int? // null = illimité
  retentionDays Int?
  monitorIntervalMin Int?
  highlighted   Boolean  @default(false)
  badge         String?
  ctaLabel      String
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
  payments       Payment[]

  @@index([active, sortOrder])
}

// Abonnement actif d'un tenant (1 par tenant).
model Subscription {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId       String
  plan         Plan     @relation(fields: [planId], references: [id])
  // active | past_due | canceled | expired
  status       String   @default("active")
  // monthly | annual
  interval     String   @default("monthly")
  provider     String   @default("fedapay")
  // Client FedaPay réutilisable (optionnel)
  providerCustomerId String?
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments Payment[]

  @@index([status])
}

// Paiement ponctuel (checkout FedaPay).
model Payment {
  id         String  @id @default(cuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId     String
  plan       Plan    @relation(fields: [planId], references: [id])
  subscriptionId String?
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  provider   String  @default("fedapay")
  // ID transaction FedaPay (renseigné dès la création de la transaction)
  providerTransactionId String? @unique
  // merchant_reference interne (unique) — permet de retrouver le paiement sans l'ID FedaPay
  reference  String  @unique
  amountXof  Int
  currency   String  @default("XOF")
  // monthly | annual
  interval   String  @default("monthly")
  // pending | approved | declined | canceled | expired | refunded
  status     String  @default("pending")
  // momo | card | ... (renseigné par le webhook quand disponible)
  method     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

// M0-5 — Quotas connus par provider (documentation + alerting).
// Volontairement SANS relation avec AICall : c'est une constante de config,
// pas une donnée transactionnelle. Modifiable via script ou dashboard admin.
model AIQuota {
  id           String   @id @default(cuid())
  provider     String   @unique
  // Quota gratuit documenté (0 = pas de limite connue)
  requestsPerDay   Int?
  requestsPerMinute Int?
  tokensPerDay     Int?
  notes        String?  // "Gratuit jusqu'à X, puis payant"
  updatedAt    DateTime @updatedAt
}

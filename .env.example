# Copier vers .env et remplir les valeurs — NE JAMAIS versionner .env
# cp .env.example .env

# Base de données
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Supabase self-hosted (Docker) — local/dev
SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY=""

# Google PageSpeed Insights (gratuit, quota 25 000 mesures/jour)
# https://console.cloud.google.com/apis/credentials
PAGESPEED_API_KEY=""

# IA — providers gratuits uniquement (chaîne de repli : Groq → Gemini → OpenRouter → Z.ai)
# Groq (gratuit) : https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini (gratuit) : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter (gratuit) : https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Z.ai (SDK z-ai-web-dev-sdk — cf. .z-ai-config.example) : https://api.z.ai
ZAI_API_KEY=

# Modèles gratuits par défaut (surchargeables — les offres gratuites changent souvent)
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.5-flash-lite
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Timeout d'un appel IA (ms)
AI_TIMEOUT_MS=60000

# Moteur de mesure : auto (PSI puis Lighthouse local) | lighthouse (100% local, TESTS ILLIMITÉS) | pagespeed (API Google seule)
# MEASURE_ENGINE=lighthouse

# Fréquence de la surveillance automatique (minutes) — 180 = 1 ronde toutes les 3h ≈ 2% du quota PSI
MONITOR_INTERVAL_MIN=180

# Timeout d'une mesure (ms)
# MEASURE_TIMEOUT_MS=180000

# ----------------------------------------------------------------------------
# Facturation — FedaPay (FCFA / XOF, Mobile Money + carte)
# Sandbox : https://sandbox.fedapay.com/register   Live : https://live.fedapay.com/register
# Docs    : https://docs.fedapay.com/
# ----------------------------------------------------------------------------
# Mode : sandbox | live   (défaut sandbox — JAMAIS mélanger les objets des 2 modes)
FEDAPAY_MODE=sandbox
# Clé secrète serveur (jamais exposée au client, jamais commitée)
FEDAPAY_SECRET_KEY=
# Clé publique (optionnelle, réservée au client si besoin futur)
FEDAPAY_PUBLIC_KEY=
# Endpoint secret du webhook (dashboard FedaPay → Webhooks) pour vérifier
# la signature X-FEDAPAY-SIGNATURE. Fortement recommandé en production.
FEDAPAY_WEBHOOK_SECRET=
# Base absolue utilisée pour construire callback_url (défaut : NEXTAUTH_URL)
# NEXTAUTH_URL=https://ton-domaine.fr

# ----------------------------------------------------------------------------
# Facturation — KKiaPay (second PSP : Mobile Money + carte)
# Sandbox : https://api-sandbox.kkiapay.me   Live : https://api.kkiapay.me
# ----------------------------------------------------------------------------
# Mode : sandbox | live   (défaut sandbox — JAMAIS mélanger les objets des 2 modes)
KKIAPAY_MODE=sandbox
# Clé publique (widget client + header X-API-KEY)
KKIAPAY_PUBLIC_KEY=
# Clé privée serveur (header X-PRIVATE-KEY — jamais exposée au client)
KKIAPAY_PRIVATE_KEY=
# Clé secrète serveur (header X-SECRET-KEY — jamais exposée au client)
KKIAPAY_SECRET_KEY=

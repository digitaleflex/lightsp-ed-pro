# =============================================================================
#  Vélocita — PRODUCTION (VPS + Traefik)
#  Copier vers .env.prod puis remplir les valeurs :  cp exemple.env.prod .env.prod
#  NE JAMAIS versionner .env.prod (déjà ignoré par .gitignore via .env*).
#  Ce fichier ne contient AUCUNE valeur réelle — placeholders uniquement.
#
#  Utilisé DEUX fois :
#    - interpolation du compose : docker compose --env-file .env.prod ...
#    - injection dans le conteneur : env_file: .env.prod
# =============================================================================

# ----------------------------------------------------------------------------
# Domaine / reverse proxy (labels Traefik)
# ----------------------------------------------------------------------------
# Domaine public servi par Traefik (sans schéma, sans slash final)
APP_HOST=tryvelocita.eurinhash.com
# Nom du réseau Docker externe de Traefik (doit exister : docker network create proxy)
TRAEFIK_NETWORK=proxy
# Nom du certresolver déclaré côté Traefik (ex: letsencrypt)
TRAEFIK_CERT_RESOLVER=letsencrypt
# Tag de l'image applicative (rollback facile en changeant le tag)
APP_IMAGE_TAG=prod

# ----------------------------------------------------------------------------
# Base de données
# ----------------------------------------------------------------------------
# Mot de passe du rôle postgres (service `db`) — SECRET à générer/roter
POSTGRES_PASSWORD=CHANGEME_mot_de_passe_fort
# Nom d'utilisateur / base (défauts OK)
POSTGRES_USER=postgres
POSTGRES_DB=postgres
# URL interne : host = nom du service compose `velocita-prod-db`, jamais exposé à l'hôte.
# Remplacer <PASSWORD> par la même valeur que POSTGRES_PASSWORD.
DATABASE_URL=postgresql://postgres:<PASSWORD>@velocita-prod-db:5432/postgres?schema=public

# ----------------------------------------------------------------------------
# Auth / URL publique
# ----------------------------------------------------------------------------
# En prod, NEXTAUTH_URL est dérivé automatiquement de APP_HOST
# (défini dans compose.prod.yml : https://${APP_HOST}) — pas besoin
# de le redéfinir ici. NEXTAUTH_SECRET reste un secret à fournir :
NEXTAUTH_SECRET=CHANGEME_secret_aleatoire_long

# ----------------------------------------------------------------------------
# Supabase self-hosted (optionnel en prod — conservé pour compat)
# ----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# Mesure de performance
# ----------------------------------------------------------------------------
# auto (PSI puis Lighthouse local) | lighthouse (100% local) | pagespeed
# lighthouse/auto nécessitent Chromium (inclus dans Dockerfile.prod).
MEASURE_ENGINE=auto
# Google PageSpeed Insights (optionnel si MEASURE_ENGINE=lighthouse)
PAGESPEED_API_KEY=
# Fréquence de la surveillance automatique (minutes)
MONITOR_INTERVAL_MIN=180
# Timeout d'un appel IA (ms)
AI_TIMEOUT_MS=60000
# Timeout d'une mesure (ms)
MEASURE_TIMEOUT_MS=180000

# ----------------------------------------------------------------------------
# IA — providers (chaîne de repli : Groq → Gemini → OpenRouter → Z.ai)
# ----------------------------------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.5-flash-lite
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ----------------------------------------------------------------------------
# Facturation — FedaPay
# ----------------------------------------------------------------------------
FEDAPAY_MODE=live
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Facturation — KKiaPay
# ----------------------------------------------------------------------------
KKIAPAY_MODE=live
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
